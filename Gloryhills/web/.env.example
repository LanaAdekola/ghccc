# Application root: Gloryhills/web relative to the Git root.
# Local development origin; Vercel Production must use https://www.ghccglobal.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public project origin and publishable/anon key, required for auth/content/storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server secret; required for public submission storage, never for admin login.
SUPABASE_SERVICE_ROLE_KEY=
# All three required for public submissions. Generate a random 32+ byte HMAC secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SECRET=
# Optional public verification token (server-read; emitted in page metadata).
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
# Legacy alternative; server-read variable above takes precedence.
NEXT_PUBLIC_GOOGLE_SEARCH_CONSOLE_VERIFICATION=
# GTM and vendor reference IDs belong in /admin/marketing, not environment variables.
# Vercel variable changes require a new deployment. Never commit real credentials.
