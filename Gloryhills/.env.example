# ==============================================================================
# Glory Hills Community Church - Environment Configuration Template
# ==============================================================================
# Never commit real credentials, secrets, or .env.local to source control.
# Public variables (NEXT_PUBLIC_*) are baked into the build at compile time;
# changing any environment variable requires a project rebuild / redeployment.

# ------------------------------------------------------------------------------
# 1. PUBLIC SITE ORIGIN
# ------------------------------------------------------------------------------
# [Public, Required in Production] Canonical HTTPS domain origin without trailing slash.
# Feature: Canonical tags, sitemap.xml, robots.txt, password-recovery callback origin.
# Redeployment Required: Yes.
# Development: Defaults safely to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://www.ghccglobal.com

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND (Database, Storage & Auth)
# ------------------------------------------------------------------------------
# [Public, Required] Supabase project origin (never append /rest/v1/).
# Feature: Content queries, media fetching, admin authentication.
# Redeployment Required: Yes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [Public, Required] Supabase anonymous publishable key, protected by database RLS.
# Feature: Public and authenticated client/server queries.
# Redeployment Required: Yes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [Server-Only Secret, Required for Private Forms] Supabase service-role key.
# Feature: Private submission writes (contact/prayer) and rate-limiting audit logs.
# Redeployment Required: Yes (Server runtime).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. SECURITY & ANTI-ABUSE
# ------------------------------------------------------------------------------
# [Server-Only Secret, Required] 32+ character random secret used for HMAC rate limit hashing.
# Feature: Anonymous API rate limiting on public submissions.
# Redeployment Required: Yes (Server runtime).
RATE_LIMIT_SECRET=your-random-32-byte-hex-or-string-secret

# [Public, Optional] Cloudflare Turnstile public site key for form CAPTCHA widget.
# Feature: Bot protection on contact, visit, and interest forms.
# Redeployment Required: Yes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# [Server-Only Secret, Optional] Cloudflare Turnstile secret key for server verification.
# Feature: Server-side validation of Turnstile CAPTCHA response tokens.
# Redeployment Required: Yes (Server runtime).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# ------------------------------------------------------------------------------
# 4. SEARCH CONSOLE VERIFICATION (Optional)
# ------------------------------------------------------------------------------
# [Public/Server, Optional] HTML meta tag verification token for Google Search Console.
# Feature: Search engine ownership verification via layout metadata.
# Redeployment Required: Yes.
# Note: Adding a DNS TXT record in your domain registrar is the recommended method.
GOOGLE_SEARCH_CONSOLE_VERIFICATION=your-google-verification-token-here

# ------------------------------------------------------------------------------
# 5. DEPRECATED / REFERENCE-ONLY ANALYTICS VARIABLES
# ------------------------------------------------------------------------------
# IMPORTANT: Google Tag Manager (GTM) is the ONLY tracking-script delivery layer.
# GTM is configured and enabled in the CMS at /admin/marketing and stored in the database.
# The active runtime does NOT load GTM from environment variables.
# GA4, Ads, and Meta IDs stored in the CMS are reference IDs for setting up GTM tags.
# Do NOT define NEXT_PUBLIC_GTM_ID as a second loading path.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
